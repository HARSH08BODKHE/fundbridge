# ==========================================
# FundBridge Backend Environment Configuration
# ==========================================

# Server Port (Default: 5000)
PORT=5000

# PostgreSQL Database Connection (e.g. Neon or local PostgreSQL)
DATABASE_URL=postgresql://username:password@ep-sample-pooler.neon.tech/fundbridge?sslmode=require

# JWT Secret for Signing Authentication Tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Resend API Key for Email OTP verification (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here

# Optional Email Sender (Default: FundBridge <onboarding@resend.dev>)
EMAIL_FROM=FundBridge <onboarding@resend.dev>

# Razorpay Credentials (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
